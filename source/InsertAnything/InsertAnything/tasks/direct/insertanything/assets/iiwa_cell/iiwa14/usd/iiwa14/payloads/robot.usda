#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "iiwa14"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "iiwa14" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "A1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "A2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "A3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "A4" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "A5" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "A6" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "A7" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__link_7tool0_oG" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "link_0" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "link_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link_2" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link_3" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link_4" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "link_5" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "link_6" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "link_7" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                        over "tool0" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

