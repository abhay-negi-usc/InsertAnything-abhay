#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "iiwa14"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "iiwa14"
{
    over "Physics"
    {
        over "A1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "A2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "A3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "A4" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "A5" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "A6" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "A7" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

